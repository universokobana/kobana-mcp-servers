{
  "name": "kobana-mcp-site",
  "version": "1.1.0",
  "description": "MCP server for searching and reading Kobana website content",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "kobana-mcp-site": "dist/index.js",
    "kobana-mcp-site-http": "dist/http-server.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "start:http": "node dist/http-server.js",
    "prepublishOnly": "npm run build",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "mcp",
    "kobana",
    "site",
    "search",
    "documentation"
  ],
  "author": "Kobana",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.23.0",
    "env-paths": "^3.0.0",
    "adm-zip": "^0.5.16"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/adm-zip": "^0.5.5",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist/**/*"
  ]
}
