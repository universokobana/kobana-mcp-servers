# Local development environment for vercel-mcp
#
# Copy this file to `.env` and fill in the values. The standalone server
# (`npm start`) loads it automatically via dotenv. `.env` is git-ignored.

# ── HTTP server ──────────────────────────────────────────────────────────────
# Port and host the standalone server binds to (defaults shown)
PORT=3000
HOST=0.0.0.0

# ── Kobana base URLs ─────────────────────────────────────────────────────────
# Production:
#   KOBANA_API_BASE_URL=https://api.kobana.com.br
#   KOBANA_APP_BASE_URL=https://app.kobana.com.br
# Sandbox:
KOBANA_API_BASE_URL=https://api-sandbox.kobana.com.br
KOBANA_APP_BASE_URL=https://app-sandbox.kobana.com.br

# Personal access token used as a fallback when OAuth is NOT configured and
# no Authorization header is sent. Optional in OAuth mode.
# KOBANA_ACCESS_TOKEN=your_personal_token

# ── Kobana OAuth (Custom Connector flow) ─────────────────────────────────────
# Required to enable the OAuth 2.1 + DCR flow used by Claude Desktop.
# Register an OAuth app at ${KOBANA_APP_BASE_URL} with redirect URI matching
# ${MCP_SERVER_URL}/oauth/callback.
KOBANA_OAUTH_CLIENT_ID=
KOBANA_OAUTH_CLIENT_SECRET=

# Public URL of THIS MCP server. Used to build redirect URIs and metadata.
# For local dev with a tunnel (ngrok / cloudflared), set this to the public URL.
MCP_SERVER_URL=http://localhost:3000
